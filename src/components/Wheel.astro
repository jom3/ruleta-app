---
import { labelAt, labelRotation, labelSize, segmentPath, shortLabel, wheelColor } from '../lib/wheel'

interface Props {
  elements: { id: string; name: string }[]
}

const { elements } = Astro.props
const count = elements.length
const step = count > 0 ? 360 / count : 360
const fontSize = labelSize(count)
---

<div class="wheel">
  <span class="wheel__pointer" aria-hidden="true"></span>
  <svg
    class="wheel__svg"
    viewBox="0 0 200 200"
    role="img"
    aria-label={`Ruleta con ${count} ${count === 1 ? 'elemento' : 'elementos'}`}
  >
    <circle class="wheel__field" cx="100" cy="100" r="96" />
    <g class="wheel__disc">
      {
        elements.map((element, index) => {
          const angle = index * step
          const label = labelAt(index, step)
          const color = wheelColor(index)
          return (
            <g data-element-id={element.id}>
              <title>{element.name}</title>
              <path
                d={segmentPath(index, step)}
                fill={color.fill}
                stroke="var(--ink-700)"
                stroke-width="1"
              />
              <text
                class="wheel__label"
                x={label.x}
                y={label.y}
                fill={color.ink}
                font-size={fontSize}
                transform={`rotate(${labelRotation(angle)} ${label.x} ${label.y})`}
                text-anchor="middle"
                dominant-baseline="middle"
              >
                {shortLabel(element.name)}
              </text>
            </g>
          )
        })
      }
    </g>
    <circle class="wheel__ring" cx="100" cy="100" r="97" />
    <circle class="wheel__hub" cx="100" cy="100" r="6" />
    <circle class="wheel__hub-dot" cx="100" cy="100" r="2.2" />
  </svg>
</div>

<style>
  .wheel {
    position: relative;
    width: clamp(240px, 74vw, 440px);
    max-width: 100%;
    margin: 0 auto var(--space-4);
    aspect-ratio: 1;
  }

  .wheel__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .wheel__disc {
    transform-box: view-box;
    transform-origin: 100px 100px;
    transition: transform 4000ms cubic-bezier(0.12, 0.72, 0.06, 1);
    will-change: transform;
  }

  .wheel__field {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.5;
    stroke-dasharray: 4 5;
  }

  .wheel__ring {
    fill: none;
    stroke: var(--brass);
    stroke-width: 1.5;
    opacity: 0.5;
  }

  .wheel__label {
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: -0.01em;
    pointer-events: none;
  }

  .wheel__hub {
    fill: var(--brass);
  }

  .wheel__hub-dot {
    fill: var(--ink-800);
  }

  .wheel__pointer {
    position: absolute;
    top: -9px;
    left: 50%;
    z-index: 1;
    width: 24px;
    height: 26px;
    transform: translateX(-50%);
    border-radius: 3px;
    background: linear-gradient(180deg, var(--brass-strong), var(--brass));
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    filter: drop-shadow(0 4px 8px rgb(0 0 0 / 0.55));
  }

  @media (prefers-reduced-motion: reduce) {
    .wheel__disc {
      transition: none;
    }
  }
</style>
