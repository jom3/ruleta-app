---
interface Props {
  elements: { id: string; name: string }[]
}

const { elements } = Astro.props
const count = elements.length
const step = count > 0 ? 360 / count : 360

const pointAt = (angle: number, radius: number) => {
  const radians = (angle * Math.PI) / 180
  return {
    x: (100 + radius * Math.sin(radians)).toFixed(2),
    y: (100 - radius * Math.cos(radians)).toFixed(2),
  }
}

const centerAngle = (index: number) => (index + 0.5) * step

const segmentPath = (index: number) => {
  const start = pointAt(index * step, 100)
  const end = pointAt((index + 1) * step, 100)
  const largeArc = step > 180 ? 1 : 0
  return `M 100 100 L ${start.x} ${start.y} A 100 100 0 ${largeArc} 1 ${end.x} ${end.y} Z`
}

const shortName = (name: string) => (name.length > 12 ? `${name.slice(0, 11)}…` : name)
const elementWord = (total: number) => (total === 1 ? 'elemento' : 'elementos')
---

<div class="wheel">
  <span class="wheel__pointer" aria-hidden="true"></span>
  <svg
    class="wheel__svg"
    viewBox="0 0 200 200"
    role="img"
    aria-label={`Ruleta con ${count} ${elementWord(count)}`}
  >
    <circle class="wheel__empty" cx="100" cy="100" r="96" />
    <g class="wheel__disc">
      {
        elements.map((element, index) => {
          const angle = centerAngle(index)
          const label = pointAt(angle, 62)
          return (
            <g data-element-id={element.id}>
              <title>{element.name}</title>
              <path d={segmentPath(index)} fill={`var(--wheel-${(index % 6) + 1})`} />
              <text
                class="wheel__label"
                x={label.x}
                y={label.y}
                transform={`rotate(${angle.toFixed(2)} ${label.x} ${label.y})`}
                text-anchor="middle"
                dominant-baseline="middle"
              >
                {shortName(element.name)}
              </text>
            </g>
          )
        })
      }
    </g>
    <circle class="wheel__hub" cx="100" cy="100" r="7" />
  </svg>
</div>

<style>
  .wheel {
    position: relative;
    width: clamp(240px, 78vw, 420px);
    max-width: 100%;
    margin: 0 auto var(--space-4);
    aspect-ratio: 1;
  }

  .wheel__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .wheel__disc {
    transform-box: view-box;
    transform-origin: 100px 100px;
    transition: transform 4000ms cubic-bezier(0.12, 0.72, 0.06, 1);
    will-change: transform;
  }

  .wheel__label {
    fill: #16181d;
    font-family: var(--font-sans);
    font-size: 8px;
    font-weight: 600;
    pointer-events: none;
  }

  .wheel__hub {
    fill: var(--color-bg);
    stroke: var(--color-accent);
    stroke-width: 3;
  }

  .wheel__empty {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 2;
    stroke-dasharray: 6 6;
  }

  .wheel__pointer {
    position: absolute;
    top: -4px;
    left: 50%;
    z-index: 1;
    width: 0;
    height: 0;
    transform: translateX(-50%);
    border-left: 9px solid transparent;
    border-right: 9px solid transparent;
    border-top: 18px solid var(--color-accent);
    filter: drop-shadow(0 2px 4px rgb(0 0 0 / 0.5));
  }

  @media (prefers-reduced-motion: reduce) {
    .wheel__disc {
      transition: none;
    }
  }
</style>
