---
import { actions } from 'astro:actions'
import AppLayout from '../../layouts/AppLayout.astro'
import { listByUser } from '../../db/categories'

const user = Astro.locals.user!
const categories = await listByUser(user.id)

const formatElementCount = (count: number): string =>
  count === 1 ? '1 elemento' : `${count} elementos`

const createResult = Astro.getActionResult(actions.createCategory)
const createError = createResult?.error?.message ?? ''
---

<AppLayout title="Mis categorías" user={user}>
  <main class="app-main">
    <header class="page-head">
      <p class="eyebrow">Tus sorteos</p>
      <h1>Mis categorías</h1>
      <p class="page-sub">
        Cada categoría guarda sus elementos y recuerda los últimos giros para no repetir.
      </p>
    </header>

    <form id="create-form" class="create-card card" method="POST" action={actions.createCategory}>
      <label for="category-name">Nueva categoría</label>
      <div class="create-card__row">
        <input
          id="category-name"
          name="name"
          type="text"
          maxlength="40"
          autocomplete="off"
          placeholder="Ej. Qué me pongo"
          required
        />
        <button type="submit" id="create-submit">Crear</button>
      </div>
      <p class="form-error" id="create-error" role="alert">{createError}</p>
    </form>

    <p class="empty-state" id="empty-state" hidden={categories.length > 0}>
      Todavía no hay categorías. Crea la primera arriba y empieza a girar.
    </p>

    <ul class="category-grid" id="category-list" hidden={categories.length === 0}>
      {
        categories.map((category) => (
          <li class="category card" data-id={category.id} data-key={category.name.toLowerCase()}>
            <a class="category__link" href={`/app/categories/${category.id}`}>
              <span class="category__title">{category.name}</span>
              <span class="category__count">{formatElementCount(category.elementCount)}</span>
            </a>
            <button
              type="button"
              class="category__delete"
              data-delete={category.id}
              aria-label={`Borrar ${category.name}`}
            >
              <span aria-hidden="true">×</span>
            </button>
          </li>
        ))
      }
    </ul>

    <template id="category-template">
      <li class="category card">
        <a class="category__link">
          <span class="category__title"></span>
          <span class="category__count"></span>
        </a>
        <button type="button" class="category__delete" data-delete>
          <span aria-hidden="true">×</span>
        </button>
      </li>
    </template>

    <dialog id="delete-dialog" class="confirm-dialog">
      <p>¿Borrar <strong id="delete-name"></strong>? También se eliminarán sus elementos y giros.</p>
      <div class="confirm-dialog__actions">
        <button type="button" class="secondary" id="delete-cancel">Cancelar</button>
        <button type="button" id="delete-confirm">Borrar</button>
      </div>
    </dialog>
  </main>
</AppLayout>

<style>
  .page-head {
    margin-bottom: var(--space-6);
  }

  .page-sub {
    max-width: 38rem;
    margin: var(--space-2) 0 0;
    color: var(--muted);
  }

  .create-card {
    padding: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .create-card__row {
    display: flex;
    gap: var(--space-2);
  }

  .create-card__row input {
    margin-bottom: 0;
    min-width: 0;
  }

  .create-card__row button {
    width: auto;
    flex-shrink: 0;
  }

  .create-card .form-error {
    margin: var(--space-2) 0 0;
  }

  .empty-state {
    padding: var(--space-8) var(--space-4);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-md);
    color: var(--muted);
    text-align: center;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .category {
    position: relative;
    transition:
      border-color 160ms var(--ease),
      transform 160ms var(--ease),
      box-shadow 160ms var(--ease);
  }

  .category:hover,
  .category:focus-within {
    border-color: var(--line-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lift);
  }

  .category__link {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
    padding: var(--space-4) 3rem var(--space-4) var(--space-4);
    color: var(--text);
    text-decoration: none;
  }

  .category__link:hover {
    color: var(--text);
  }

  .category__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .category__count {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .category__delete {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    font-size: 1.15rem;
    line-height: 1;
  }

  .category__delete:hover:not(:disabled) {
    background: rgb(226 104 92 / 0.14);
    color: var(--danger);
    filter: none;
  }
</style>

<script>
  import { actions } from 'astro:actions'

  const form = document.querySelector<HTMLFormElement>('#create-form')!
  const input = document.querySelector<HTMLInputElement>('#category-name')!
  const submitButton = document.querySelector<HTMLButtonElement>('#create-submit')!
  const errorBox = document.querySelector<HTMLParagraphElement>('#create-error')!
  const list = document.querySelector<HTMLUListElement>('#category-list')!
  const emptyState = document.querySelector<HTMLParagraphElement>('#empty-state')!
  const template = document.querySelector<HTMLTemplateElement>('#category-template')!
  const dialog = document.querySelector<HTMLDialogElement>('#delete-dialog')!
  const deleteName = document.querySelector<HTMLElement>('#delete-name')!
  const deleteConfirm = document.querySelector<HTMLButtonElement>('#delete-confirm')!
  const deleteCancel = document.querySelector<HTMLButtonElement>('#delete-cancel')!

  let pendingDelete: { id: string; item: HTMLLIElement } | null = null

  function toggleEmptyState(): void {
    const isEmpty = list.children.length === 0
    emptyState.hidden = !isEmpty
    list.hidden = isEmpty
  }

  function buildItem(category: { id: string; name: string }): HTMLLIElement {
    const item = template.content.firstElementChild!.cloneNode(true) as HTMLLIElement
    item.dataset.id = category.id
    item.dataset.key = category.name.toLowerCase()

    const link = item.querySelector<HTMLAnchorElement>('.category__link')!
    link.href = `/app/categories/${category.id}`
    link.setAttribute('aria-label', category.name)

    item.querySelector('.category__title')!.textContent = category.name
    item.querySelector('.category__count')!.textContent = '0 elementos'

    const deleteButton = item.querySelector<HTMLButtonElement>('.category__delete')!
    deleteButton.dataset.delete = category.id
    deleteButton.setAttribute('aria-label', `Borrar ${category.name}`)
    return item
  }

  function insertItem(category: { id: string; name: string }): void {
    const item = buildItem(category)
    const key = category.name.toLowerCase()
    const next = [...list.children].find(
      (child) => ((child as HTMLLIElement).dataset.key ?? '') > key,
    )

    list.insertBefore(item, next ?? null)
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault()
    errorBox.textContent = ''
    submitButton.disabled = true

    const { data, error } = await actions.createCategory({ name: input.value })

    submitButton.disabled = false

    if (error) {
      errorBox.textContent = error.message
      input.focus()
      return
    }

    insertItem(data)
    form.reset()
    toggleEmptyState()
    input.focus()
  })

  list.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-delete]')
    const item = button?.closest<HTMLLIElement>('.category')
    if (!button || !item) return

    pendingDelete = { id: button.dataset.delete!, item }
    deleteName.textContent = item.querySelector('.category__title')?.textContent ?? ''
    dialog.showModal()
  })

  deleteCancel.addEventListener('click', () => {
    pendingDelete = null
    dialog.close()
  })

  deleteConfirm.addEventListener('click', async () => {
    if (!pendingDelete) return

    deleteConfirm.disabled = true
    const { error } = await actions.deleteCategory({ id: pendingDelete.id })
    deleteConfirm.disabled = false

    if (error) {
      dialog.close()
      errorBox.textContent = error.message
      return
    }

    pendingDelete.item.remove()
    pendingDelete = null
    dialog.close()
    toggleEmptyState()
  })
</script>
