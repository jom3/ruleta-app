---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Nueva contraseña">
  <main>
    <h1>Nueva contraseña</h1>

    <form id="reset-form" novalidate>
      <p class="form-error" id="reset-error" role="alert"></p>

      <label for="password">Contraseña</label>
      <input
        id="password"
        name="password"
        type="password"
        autocomplete="new-password"
        minlength="8"
        required
      />

      <button type="submit" id="reset-submit">Guardar contraseña</button>
    </form>

    <p class="form-alt" id="invalid-link" hidden>
      El enlace no es válido o caducó. <a href="/forgot-password">Solicita uno nuevo</a>
    </p>

    <p class="form-alt"><a href="/login">Volver al inicio de sesión</a></p>
  </main>
</BaseLayout>

<script>
  import { createAuthClient } from 'better-auth/client'
  import { isValidPassword, MIN_PASSWORD_LENGTH } from '../lib/password'

  const authClient = createAuthClient()
  const form = document.querySelector<HTMLFormElement>('#reset-form')!
  const errorBox = document.querySelector<HTMLParagraphElement>('#reset-error')!
  const submitButton = document.querySelector<HTMLButtonElement>('#reset-submit')!
  const invalidLink = document.querySelector<HTMLParagraphElement>('#invalid-link')!

  const token = new URLSearchParams(window.location.search).get('token') ?? ''

  function showInvalidLink(): void {
    form.hidden = true
    invalidLink.hidden = false
  }

  if (token === '') {
    showInvalidLink()
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault()
    errorBox.textContent = ''

    const password = String(new FormData(form).get('password') ?? '')
    if (!isValidPassword(password)) {
      errorBox.textContent = `La contraseña debe tener al menos ${MIN_PASSWORD_LENGTH} caracteres.`
      return
    }

    submitButton.disabled = true
    const { error } = await authClient.resetPassword({ newPassword: password, token })
    submitButton.disabled = false

    if (error) {
      showInvalidLink()
      return
    }

    window.location.assign('/login?reset=ok')
  })
</script>
