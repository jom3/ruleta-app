---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Recuperar contraseña">
  <main>
    <h1>Recuperar contraseña</h1>
    <form id="forgot-form" novalidate>
      <p class="form-error" id="forgot-error" role="alert"></p>
      <p class="form-success" id="forgot-success" role="status"></p>

      <label for="email">Correo</label>
      <input id="email" name="email" type="email" autocomplete="email" required />

      <button type="submit" id="forgot-submit">Enviar enlace</button>
    </form>

    <p class="form-alt"><a href="/login">Volver al inicio de sesión</a></p>
  </main>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#forgot-form')!
  const errorBox = document.querySelector<HTMLParagraphElement>('#forgot-error')!
  const successBox = document.querySelector<HTMLParagraphElement>('#forgot-success')!
  const submitButton = document.querySelector<HTMLButtonElement>('#forgot-submit')!

  form.addEventListener('submit', async (event) => {
    event.preventDefault()
    errorBox.textContent = ''
    successBox.textContent = ''

    const email = String(new FormData(form).get('email') ?? '').trim()
    if (email === '') {
      errorBox.textContent = 'Escribe tu correo.'
      return
    }

    submitButton.disabled = true
    try {
      await fetch('/api/password/forgot', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      })
      successBox.textContent =
        'Si el correo tiene cuenta, enviamos un enlace para restablecer la contraseña.'
      form.reset()
    } catch {
      errorBox.textContent = 'No se pudo enviar la solicitud. Inténtalo de nuevo.'
    } finally {
      submitButton.disabled = false
    }
  })
</script>
