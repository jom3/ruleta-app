---
import BaseLayout from '../layouts/BaseLayout.astro'

if (Astro.locals.user) {
  return Astro.redirect('/app')
}
---

<BaseLayout title="Crear cuenta">
  <main>
    <h1>Crear cuenta</h1>
    <form id="register-form" novalidate>
      <p class="form-error" id="register-error" role="alert"></p>

      <label for="email">Correo</label>
      <input id="email" name="email" type="email" autocomplete="email" required />

      <label for="password">Contraseña</label>
      <input
        id="password"
        name="password"
        type="password"
        autocomplete="new-password"
        minlength="8"
        required
      />

      <button type="submit" id="register-submit">Crear cuenta</button>
    </form>

    <button type="button" class="secondary" id="google-register" style="margin-top: 0.75rem">
      Continuar con Google
    </button>

    <p class="form-alt">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
  </main>
</BaseLayout>

<script>
  import { createAuthClient } from 'better-auth/client'
  import { isValidPassword, MIN_PASSWORD_LENGTH } from '../lib/password'

  const authClient = createAuthClient()
  const form = document.querySelector<HTMLFormElement>('#register-form')!
  const errorBox = document.querySelector<HTMLParagraphElement>('#register-error')!
  const submitButton = document.querySelector<HTMLButtonElement>('#register-submit')!
  const googleButton = document.querySelector<HTMLButtonElement>('#google-register')!

  const duplicateAccountMessage =
    'Ese correo ya tiene cuenta. Inicia sesión; si la creaste con Google, usa "Continuar con Google".'

  function isDuplicateAccount(error: { code?: string; message?: string }): boolean {
    return error.code?.startsWith('USER_ALREADY_EXISTS') || /already exists/i.test(error.message ?? '')
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault()
    errorBox.textContent = ''

    const data = new FormData(form)
    const email = String(data.get('email') ?? '').trim()
    const password = String(data.get('password') ?? '')

    if (!isValidPassword(password)) {
      errorBox.textContent = `La contraseña debe tener al menos ${MIN_PASSWORD_LENGTH} caracteres.`
      return
    }

    submitButton.disabled = true
    const { error } = await authClient.signUp.email({
      email,
      password,
      name: email.split('@')[0] || email,
    })
    submitButton.disabled = false

    if (error) {
      errorBox.textContent = isDuplicateAccount(error)
        ? duplicateAccountMessage
        : `No se pudo crear la cuenta: ${error.message ?? 'inténtalo de nuevo'}`
      return
    }

    window.location.assign('/app')
  })

  googleButton.addEventListener('click', async () => {
    errorBox.textContent = ''
    const { error } = await authClient.signIn.social({ provider: 'google', callbackURL: '/app' })
    if (error) {
      errorBox.textContent = 'No se pudo conectar con Google. Inténtalo de nuevo.'
    }
  })
</script>
